# Example environment variables for local development (do NOT commit secrets)
# Replace values in a local .env.local file that is gitignored

BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection string. Leave unset in dev to use the in-memory adapter;
# set it (e.g. to a Supabase connection string) to use a real database.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" URI, port 6543, for serverless/Vercel).
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Optional alias
AUTH_SECRET=${BETTER_AUTH_SECRET}

# Email verification (better-auth requireEmailVerification), sent via SMTP.
# Without SMTP_HOST, verification emails are logged to the server console
# instead of sent, so sign-up still works in local development.
# Gmail: smtp.gmail.com, port 587, requires an "App Password" (not your
# normal password) — https://myaccount.google.com/apppasswords
# Outlook/Office365: smtp.office365.com, port 587
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password_here
# EMAIL_FROM="MesaFlow <you@gmail.com>"

# Claude / Anthropic API (set when integrating Claude Code)
# CLAUDE_API_KEY=your_claude_api_key_here
# Optional: override default API URL
# CLAUDE_API_URL=https://api.anthropic.com
