# Example environment variables for local development (do NOT commit secrets)
# Replace values in a local .env.local file that is gitignored

BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Example Postgres connection string (only for production/local dev with DB)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Optional alias
AUTH_SECRET=${BETTER_AUTH_SECRET}
